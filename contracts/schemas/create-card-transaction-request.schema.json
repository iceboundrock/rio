{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.local/schemas/create-card-transaction-request.schema.json",
  "title": "CreateCardTransactionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "amount", "type"],
  "properties": {
    "description": {
      "description": "Not blank, and free of U+0000, which PostgreSQL text cannot store. A schema object takes one pattern, so the second rule is a subschema.",
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": { "pattern": "\\u0000" }
    },
    "amount": { "$ref": "money.schema.json#/$defs/positive" },
    "type": { "type": "string", "enum": ["CREDIT", "DEBIT"] }
  }
}
